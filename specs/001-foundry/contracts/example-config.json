    "osv_database_ref": "operator-staged-osv-fixture-snapshot",
    "techniques": [
      "rule",
      "dependency",
      "secret",
      "exploratory"
    ]
  },
  "fleet": {
    "counts": {
      "indexer": 1,
      "cartographer": 1,
      "detector": 1,
      "triager": 1,
      "validator": 1,
      "reporter": 1,
      "coverage-guide": 1
    },
    "soft_session_seconds": 9000,
    "hard_session_seconds": 9900,
    "validator_attempts": 3,
    "heartbeat_seconds": 10,
