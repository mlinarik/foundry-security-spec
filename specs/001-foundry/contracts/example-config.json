{
  "schema_version": "0.1.0",
  "name": "authorized-fixture-evaluation",
  "target": [
    {
      "repository": "https://github.com/REPLACE_OWNER/REPLACE_TARGET",
      "revision": "0000000000000000000000000000000000000000",
      "include": [
        "**/*.py",
        "**/*.go"
      ],
      "exclude": [
        "vendor/**",
        "generated/**"
      ]
    }
  ],
  "goals": "Evaluate authentication, authorization, input handling, dependencies, and exposed secrets in the authorized fixture target.",
  "testbed": null,
  "rules": {
    "hard_rules": [
      "No denial of service, data deletion, credential changes, or actions affecting non-test users."
    ]
